# Copy to .env and fill in. .env is gitignored; never put real credentials in this file.
PORT=3000
# Public host the SMS link points at; must match authHost in app/build.gradle.kts
AUTH_HOST=billy.example.com
# Where routes are mounted; must match the path in API_BASE_URL
BASE_PATH=/api
DB_PATH=./billy.db
LOGIN_TOKEN_TTL_MINUTES=10
SESSION_TTL_DAYS=30

# Twilio. Leave unset in development: the SMS is printed to the server console instead.
# Formats: account SID "AC" + 32 hex chars, auth token 32 hex chars, from number in E.164 (+15551234567).
# Set either TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID ("MG" + 32 hex chars).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Set to 1 only if running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
# Android App Links verification (served at /.well-known/assetlinks.json)
ANDROID_PACKAGE=com.example.billy
ANDROID_SHA256_CERT_FINGERPRINT=
