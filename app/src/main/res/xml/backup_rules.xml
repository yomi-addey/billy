<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower (API 31+ uses data_extraction_rules.xml).
   The session token is encrypted with a non-exportable Android Keystore key, so a backed-up
   copy could never be decrypted on another device. Keep auth data out of backups entirely.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/secure_auth.preferences_pb" />
    <exclude domain="sharedpref" path="auth.xml" />
</full-backup-content>
