<?xml version="1.0" encoding="utf-8"?>
<!--
   The session token is encrypted with a non-exportable Android Keystore key, so a backed-up or
   transferred copy could never be decrypted on another device. Keep auth data out of both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secure_auth.preferences_pb" />
        <exclude domain="sharedpref" path="auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secure_auth.preferences_pb" />
        <exclude domain="sharedpref" path="auth.xml" />
    </device-transfer>
</data-extraction-rules>
